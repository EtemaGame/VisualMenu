{
  "name": "visualmenu-studio",
  "version": "1.0.0",
  "description": "Professional HUD & UI Designer Suite",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "package": "electron-packager . \"VisualMenu Studio\" --platform=win32 --arch=x64 --out=dist --overwrite --icon=dist\\.icon-ico\\icon.ico --ignore=node-v24.14.1-win-x64 --ignore=dist --ignore=.git"
  },
  "author": "EtemaGame",
  "license": "ISC",
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.etemagame.visualmenu",
    "productName": "VisualMenu Studio",
    "files": [
      "**/*",
      "!node-v24.14.1-win-x64/**",
      "!dist/**",
      "!.git/**",
      "!*.md"
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "dist/.icon-ico/icon.ico"
    },
    "directories": {
      "output": "dist"
    }
  }
}
